{
  "buildCommand": "npm run build",
  "outputDirectory": ".output",
  "framework": null,
  "functions": {
    "server/index.mjs": {
      "includeFiles": "server/**"
    }
  },
  "routes": [
    {
      "src": "/_build/(.*)",
      "dest": "/client/_build/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/server/index.mjs"
    }
  ]
}
